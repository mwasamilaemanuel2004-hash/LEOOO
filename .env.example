# REXM AI Trading Bot Configuration

# Admin Credentials
ADMIN_EMAIL=eestradingmachine@gmail.com
ADMIN_PASSWORD=esMwas@2004

# Binance API
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_TESTNET=True

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rexm_ai
REDIS_URL=redis://localhost:6379/0

# Flask
FLASK_ENV=production
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key

# Trading Parameters
MIN_CAPITAL=5
MAX_CAPITAL=1000
MIN_PROFIT_TARGET=0.8
MAX_PROFIT_TARGET=50

# IP Configuration
PUBLIC_IPV4=your_public_ipv4_here
BOT_INSTANCES=2

# Notifications
TELEGRAM_BOT_TOKEN=your_telegram_token
TELEGRAM_CHAT_ID=your_chat_id

# Timeframes (in minutes)
SCALPING_TIMEFRAMES=5,10,15
INTRADAY_TIMEFRAMES=30,60,240
SWING_TIMEFRAMES=720,1440

# Risk Management
MAX_DAILY_LOSS_PERCENT=5
MAX_WEEKLY_LOSS_PERCENT=10
MAX_MONTHLY_LOSS_PERCENT=15
MAX_DRAWDOWN_PERCENT=20
